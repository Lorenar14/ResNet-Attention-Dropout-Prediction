# -*- coding: utf-8 -*-
"""Phase 3. Exploratory Data Analysis."""

from pathlib import Path

import matplotlib.pyplot as plt
import pandas as pd
import seaborn as sns
from matplotlib.backends.backend_pdf import PdfPages

BASE_DIR = Path("/content")
OUTPUT_DIR = BASE_DIR / "Results"
FIGURE_DIR = OUTPUT_DIR / "Figures"
INPUT_FILE = OUTPUT_DIR / "Modeling_Dataset.csv"
PDF_FILE = FIGURE_DIR / "Phase3_Exploratory_Data_Analysis.pdf"

FIGURE_DIR.mkdir(parents=True, exist_ok=True)

PALETTE_BLUE_DARK = "#17365D"
PALETTE_RED_DARK = "#8B1E2D"
PALETTE_TEAL = "#2A7F8E"
PALETTE_GOLD = "#C49A35"

sns.set_theme(style="whitegrid", context="notebook")

plt.rcParams.update({
    "font.family": "DejaVu Sans",
    "font.size": 10,
    "axes.titlesize": 13,
    "axes.titleweight": "bold",
    "axes.labelsize": 10,
    "xtick.labelsize": 9,
    "ytick.labelsize": 9,
    "figure.facecolor": "white",
    "axes.facecolor": "white",
    "savefig.facecolor": "white",
    "pdf.fonttype": 42,
    "ps.fonttype": 42,
})

if not INPUT_FILE.exists():
    raise FileNotFoundError(
        f"Dataset not found: {INPUT_FILE}. Run Phase 2 first."
    )

df = pd.read_csv(
    INPUT_FILE,
    sep=";",
    encoding="utf-8-sig",
    low_memory=False,
)

df.columns = df.columns.astype(str).str.strip().str.upper()

if df.empty:
    raise ValueError("The modeling dataset is empty.")

def find_column(candidates, dataframe):
    for candidate in candidates:
        if candidate in dataframe.columns:
            return candidate
    return None


target_col = find_column(["TARGET"], df)
level_col = find_column(["CURRENT_LEVEL", "NIVEL_ACTUAL"], df)
age_col = find_column(["AGE", "EDAD"], df)
stratum_col = find_column(["STRATUM", "ESTRATO"], df)

required_columns = {
    "TARGET": target_col,
    "current academic level": level_col,
    "age": age_col,
    "socioeconomic stratum": stratum_col,
}

missing_columns = [
    name for name, column in required_columns.items()
    if column is None
]

if missing_columns:
    raise KeyError(
        "Required variables not found: "
        + ", ".join(missing_columns)
    )

df[target_col] = pd.to_numeric(df[target_col], errors="coerce")

if df[target_col].isna().any():
    raise ValueError("TARGET contains missing or invalid values.")

if not set(df[target_col].unique()).issubset({0, 1}):
    raise ValueError("TARGET must contain only 0 and 1.")

df[target_col] = df[target_col].astype(int)

for column in [level_col, age_col, stratum_col]:
    df[column] = pd.to_numeric(df[column], errors="coerce")

# Create five-year age groups
valid_ages = df[age_col].dropna()

if valid_ages.empty:
    raise ValueError("No valid age values are available.")

age_min = int(valid_ages.min())
age_max = int(valid_ages.max())

age_start = (age_min // 5) * 5
age_end = (age_max // 5 + 1) * 5

age_bins = list(range(age_start, age_end + 1, 5))

if len(age_bins) < 2:
    age_bins = [age_start, age_start + 5]

age_labels = [
    f"{age_bins[i]}–{age_bins[i + 1] - 1}"
    for i in range(len(age_bins) - 1)
]

df["AGE_GROUP"] = pd.cut(
    df[age_col],
    bins=age_bins,
    labels=age_labels,
    right=False,
    include_lowest=True,
)

# Prepare socioeconomic strata
df["STRATUM_GROUP"] = df[stratum_col].map(
    lambda value: (
        str(int(value))
        if pd.notna(value) and float(value).is_integer()
        else str(value)
        if pd.notna(value)
        else None
    )
)


def summarize_group(dataframe, group_column):
    valid_data = dataframe.dropna(
        subset=[group_column, target_col]
    ).copy()

    summary = (
        valid_data.groupby(group_column, observed=True)[target_col]
        .agg(
            TOTAL_STUDENTS="count",
            OPERATIONAL_DROPOUTS="sum",
        )
        .reset_index()
    )

    summary["DROPOUT_RATE_PERCENT"] = (
        summary["OPERATIONAL_DROPOUTS"]
        / summary["TOTAL_STUDENTS"]
        * 100
    )

    total_operational_cases = summary["OPERATIONAL_DROPOUTS"].sum()

    summary["CASE_SHARE_PERCENT"] = (
        summary["OPERATIONAL_DROPOUTS"]
        / max(total_operational_cases, 1)
        * 100
    )

    return summary


def format_axis(ax):
    ax.spines["top"].set_visible(False)
    ax.spines["right"].set_visible(False)
    ax.grid(axis="y", visible=False)
    ax.grid(axis="x", linestyle=":", linewidth=0.7, alpha=0.5)
    ax.set_axisbelow(True)


def save_numbered_figure(pdf, number, title, fig):
    fig.suptitle(
        f"Figure {number}. {title}",
        fontsize=13,
        fontweight="bold",
        x=0.5,
        y=0.98,
    )

    fig.tight_layout(rect=[0.02, 0.02, 0.98, 0.93])

    filename = (
        f"Figure_{number:02d}_"
        + title.lower().replace(" ", "_").replace("-", "_")
        + ".png"
    )

    fig.savefig(
        FIGURE_DIR / filename,
        dpi=600,
        bbox_inches="tight",
    )

    pdf.savefig(fig, bbox_inches="tight")
    plt.show()
    plt.close(fig)


def plot_counts(pdf, number, title, summary, group_column, x_label):
    plot_data = summary.copy()
    plot_data[group_column] = plot_data[group_column].astype(str)
    plot_data = plot_data.sort_values("OPERATIONAL_DROPOUTS")

    fig_height = max(4.8, 0.48 * len(plot_data) + 1.5)
    fig, ax = plt.subplots(figsize=(10, fig_height))

    bars = ax.barh(
        plot_data[group_column],
        plot_data["OPERATIONAL_DROPOUTS"],
        color=PALETTE_RED_DARK,
        height=0.65,
    )

    maximum = max(plot_data["OPERATIONAL_DROPOUTS"].max(), 1)
    ax.set_xlim(0, maximum * 1.38)

    for bar, share in zip(bars, plot_data["CASE_SHARE_PERCENT"]):
        value = int(bar.get_width())

        ax.annotate(
            f"{value:,}  ({share:.1f}% of cases)",
            xy=(value, bar.get_y() + bar.get_height() / 2),
            xytext=(7, 0),
            textcoords="offset points",
            ha="left",
            va="center",
            fontsize=8.5,
        )

    ax.set_xlabel(x_label, labelpad=8)
    ax.set_ylabel("")
    ax.tick_params(axis="y", length=0, pad=7)
    format_axis(ax)

    save_numbered_figure(pdf, number, title, fig)


def plot_rates(pdf, number, title, summary, group_column, x_label):
    plot_data = summary.copy()
    plot_data[group_column] = plot_data[group_column].astype(str)
    plot_data = plot_data.sort_values("DROPOUT_RATE_PERCENT")

    fig_height = max(4.8, 0.48 * len(plot_data) + 1.5)
    fig, ax = plt.subplots(figsize=(10, fig_height))

    bars = ax.barh(
        plot_data[group_column],
        plot_data["DROPOUT_RATE_PERCENT"],
        color=PALETTE_BLUE_DARK,
        height=0.65,
    )

    maximum = max(plot_data["DROPOUT_RATE_PERCENT"].max(), 1)
    ax.set_xlim(0, maximum * 1.3)

    for bar, total in zip(bars, plot_data["TOTAL_STUDENTS"]):
        rate = bar.get_width()

        ax.annotate(
            f"{rate:.1f}%  (n={int(total):,})",
            xy=(rate, bar.get_y() + bar.get_height() / 2),
            xytext=(7, 0),
            textcoords="offset points",
            ha="left",
            va="center",
            fontsize=8.5,
        )

    ax.set_xlabel("Operational dropout rate (%)", labelpad=8)
    ax.set_ylabel(x_label)
    ax.tick_params(axis="y", length=0, pad=7)
    format_axis(ax)

    save_numbered_figure(pdf, number, title, fig)


with PdfPages(PDF_FILE) as pdf:

    # Figure 1: Overall target distribution
    target_counts = (
        df[target_col]
        .value_counts()
        .reindex([0, 1], fill_value=0)
    )

    labels = ["Non-dropout (0)", "Operational dropout (1)"]
    percentages = target_counts / len(df) * 100

    fig, ax = plt.subplots(figsize=(8.5, 5.2))

    bars = ax.bar(
        labels,
        target_counts.values,
        color=[PALETTE_BLUE_DARK, PALETTE_RED_DARK],
        width=0.58,
    )

    maximum = max(target_counts.max(), 1)
    ax.set_ylim(0, maximum * 1.18)
    ax.set_ylabel("Number of students")
    ax.set_xlabel("Operational target class")

    for bar, percentage in zip(bars, percentages):
        ax.annotate(
            f"{int(bar.get_height()):,} ({percentage:.1f}%)",
            xy=(bar.get_x() + bar.get_width() / 2, bar.get_height()),
            xytext=(0, 6),
            textcoords="offset points",
            ha="center",
            va="bottom",
            fontsize=9,
        )

    format_axis(ax)

    save_numbered_figure(
        pdf,
        1,
        "Distribution of the Operational Target",
        fig,
    )

    # Figures 2 and 3: Current academic level
    level_summary = summarize_group(df, level_col)

    level_summary = level_summary.sort_values(level_col)

    plot_counts(
        pdf,
        2,
        "Operational Dropout by Current Academic Level",
        level_summary,
        level_col,
        "Number of operational dropout cases",
    )

    plot_rates(
        pdf,
        3,
        "Operational Dropout Rate by Current Academic Level",
        level_summary,
        level_col,
        "Current academic level",
    )

    # Figures 4 and 5: Age group
    age_summary = summarize_group(df, "AGE_GROUP")

    age_order = {label: index for index, label in enumerate(age_labels)}
    age_summary["_ORDER"] = age_summary["AGE_GROUP"].astype(str).map(age_order)
    age_summary = age_summary.sort_values("_ORDER")

    plot_counts(
        pdf,
        4,
        "Operational Dropout by Age Group",
        age_summary,
        "AGE_GROUP",
        "Number of operational dropout cases",
    )

    plot_rates(
        pdf,
        5,
        "Operational Dropout Rate by Age Group",
        age_summary,
        "AGE_GROUP",
        "Age group (years)",
    )

    # Figures 6 and 7: Socioeconomic stratum
    stratum_summary = summarize_group(df, "STRATUM_GROUP")

    stratum_summary["_ORDER"] = pd.to_numeric(
        stratum_summary["STRATUM_GROUP"],
        errors="coerce",
    )

    stratum_summary = stratum_summary.sort_values(
        "_ORDER",
        na_position="last",
    )

    plot_counts(
        pdf,
        6,
        "Operational Dropout by Socioeconomic Stratum",
        stratum_summary,
        "STRATUM_GROUP",
        "Number of operational dropout cases",
    )

    plot_rates(
        pdf,
        7,
        "Operational Dropout Rate by Socioeconomic Stratum",
        stratum_summary,
        "STRATUM_GROUP",
        "Socioeconomic stratum",
    )

print("Phase 3 completed successfully.")
print("Figures generated: 7")
print(f"Records analyzed: {len(df):,}")
print(f"Variables analyzed: {len(df.columns):,}")
print(f"PDF report: {PDF_FILE}")
print(f"Individual figures: {FIGURE_DIR}")
